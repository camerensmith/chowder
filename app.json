{
  "expo": {
    "name": "Chowder",
    "slug": "chowder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chowder.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.chowder.app"
    },
    "web": {
      "favicon": "./assets/appicon.png",
      "bundler": "metro",
      "name": "Chowder",
      "shortName": "Chowder",
      "lang": "en",
      "scope": "/",
      "themeColor": "#9C321B",
      "backgroundColor": "#F8F3F5",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "description": "Track your favorite local food and restaurants"
    },
    "scheme": "chowder",
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chowder uses your photos for place, dish and profile pictures.",
          "cameraPermission": "Chowder uses the camera to take photos of places and dishes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chowder uses your location to center the map near you."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3e73e6e3-1406-4770-a741-8e77acfc912e"
      }
    }
  }
}
